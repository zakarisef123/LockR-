{
  "name": "lockr-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "VITE_DEMO=1 vite",
    "build": "vite build",
    "build:demo": "VITE_DEMO=1 vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:rules": "npx -y firebase-tools@14 emulators:exec --project demo-lockr --only firestore \"node --test tests/rules.test.mjs\"",
    "test:functions": "npx -y firebase-tools@14 emulators:exec --project demo-lockr --only auth,firestore \"node --test --test-concurrency=1 tests/functions.test.mjs\"",
    "test": "npm run test:rules && npm run test:functions"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "firebase-admin": "^13.10.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "stripe": "^18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "javascript-obfuscator": "^5.4.3",
    "playwright": "^1.60.0",
    "terser": "^5.48.0",
    "vite": "^8.0.12",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "vite-plugin-obfuscator": "^1.0.5"
  }
}
